@tool
extends RefCounted

## playtest op=export_gd (v1.16 M5c): a saved suite as a standalone GDScript test.
##
## The test is playtest_standalone.gd (the template) with its first line replaced by a header of comments and
## its data block replaced by the suite's own constants. Nothing a suite holds may become code: every string goes
## through quote() (one line, every character that could end the literal or that GDScript refuses escaped),
## every number through lit_float() (it reads back as the same double, and a whole float stays a float), and
## every header line through comment_text() (no line break, no backslash, no text-direction control). The
## result is compiled before it is handed back (parse_error), so a test that would not load is never written.
##
## What the standalone test cannot run is listed, not dropped: a screenshot assert (no rendered frame), a perf
## assert (no replay window measurements), a no_overlap assert (no physics query of Beckett's), an assert, event
## or step of a type nobody knows, and an entry that is not an object. The list is in the reply (not_run) and in
## the file's header, and the test prints each one as skipped.
##
## Static and dependency-light on purpose: it preloads only path_guard.gd and callargs.gd, so the unit suite can
## run it in a child engine with just those files.

const PathGuard := preload("res://addons/beckett/core/path_guard.gd")  # the rule for a path an agent names
const CallArgs := preload("res://addons/beckett/core/callargs.gd")  # settle_frames can arrive as text

const TEMPLATE_PATH := "res://addons/beckett/tools/playtest_standalone.gd"
## The first line of every generated test: op=export_gd only ever overwrites a file that begins with it.
const GENERATED_MARK := "# Generated by Beckett playtest op=export_gd: a standalone test of a saved playtest suite."
const HEADER_MARK := "# @@HEADER@@"
const DATA_BEGIN := "# @@DATA-BEGIN@@"
const DATA_END := "# @@DATA-END@@"
const COMMENT_CAP := 160
const SCENE_MAX := 300
const SETTLE_DEFAULT := 4
const STEP_TIMEOUT_DEFAULT := 5000
const KIND_CAP := 40

const ASSERT_KNOWN := ["node_state", "expr", "screen_text"]
const EVENT_TYPES := ["key", "action", "mouse_button", "mouse_motion", "joy_button", "joy_axis", "touch", "touch_drag"]
const STEP_KEYS := ["click", "type", "wait", "assert", "input", "inject", "state"]
## The text-direction controls (marks, embeddings, overrides, isolates): GDScript refuses each of them raw in a
## string literal, and in a comment they would draw a line as something it is not.
const BIDI := [0x200E, 0x200F, 0x202A, 0x202B, 0x202C, 0x202D, 0x202E, 0x2066, 0x2067, 0x2068, 0x2069]

const WHY_SCREENSHOT := "it compares a rendered frame with its baseline image, and a headless standalone test renders no frame"
const WHY_PERF := "it reads the measurements of the editor's replay window (frame times, memory), which the standalone test does not take"
const WHY_OVERLAP := "it needs Beckett's physics overlap query (the addon), which the standalone test does not have"


# ---------------------------------------------------------------- literals

## `s` as a one-line GDScript string literal that compiles back to exactly `s`.
static func quote(s: String) -> String:
	var out := "\""
	for i in s.length():
		var c := s.unicode_at(i)
		match c:
			34:
				out += "\\\""
			92:
				out += "\\\\"
			10:
				out += "\\n"
			13:
				out += "\\r"
			9:
				out += "\\t"
			_:
				if c < 32 or (c >= 0x7F and c < 0xA0) or c == 0x2028 or c == 0x2029 or c == 0xFEFF or BIDI.has(c) or (c >= 0xD800 and c <= 0xDFFF):
					out += "\\u%04x" % c
				else:
					out += s[i]
	return out + "\""


## A float literal that reads back as the same double and stays a float (7.0, not 7); NaN and the infinities,
## which a JSON file cannot hold, as their constants.
static func lit_float(f: float) -> String:
	if is_nan(f):
		return "NAN"
	if is_inf(f):
		return "INF" if f > 0.0 else "-INF"
	var s := var_to_str(f)  # the shortest text that reads back as the same double
	if not (s.contains(".") or s.contains("e") or s.contains("E")):
		s += ".0"
	return s


## A one-line GDScript literal of a JSON document: null, bools, ints, floats, strings, arrays and dictionaries
## (a key is always text). A value of any other type becomes its text, as a string.
static func lit(v: Variant) -> String:
	match typeof(v):
		TYPE_NIL:
			return "null"
		TYPE_BOOL:
			return "true" if v else "false"
		TYPE_INT:
			return str(v)
		TYPE_FLOAT:
			return lit_float(v)
		TYPE_STRING, TYPE_STRING_NAME:
			return quote(str(v))
		TYPE_ARRAY:
			var parts := PackedStringArray()
			for e in (v as Array):
				parts.append(lit(e))
			return "[" + ", ".join(parts) + "]"
		TYPE_DICTIONARY:
			var pairs := PackedStringArray()
			for k in (v as Dictionary):
				pairs.append(quote(str(k)) + ": " + lit((v as Dictionary)[k]))
			return "{" + ", ".join(pairs) + "}"
	return quote(str(v))


## Text for a header comment: one line (every line break, control character, backslash and text-direction
## control is a space), cut to `cap` characters with "..." when longer.
static func comment_text(s: String, cap: int = COMMENT_CAP) -> String:
	var out := ""
	for i in mini(s.length(), cap):
		var c := s.unicode_at(i)
		if c < 32 or (c >= 0x7F and c < 0xA0) or c == 92 or c == 0x2028 or c == 0x2029 or c == 0xFEFF or BIDI.has(c) or (c >= 0xD800 and c <= 0xDFFF):
			out += " "
		else:
			out += s[i]
	if s.length() > cap:
		out += "..."
	return out


# ---------------------------------------------------------------- where the file goes

## "" when the test may be written at `path`, else why not (the caller prefixes "op=export_gd: ").
static func path_error(path: String) -> String:
	if not path.begins_with("res://"):
		return "path must start with res://: the test is a script of this project (got '%s')" % comment_text(path, 80)
	for i in path.length():
		var c := path.unicode_at(i)
		if c < 32 or c == 127:
			return "path must not contain control characters"
	if path.contains(".."):
		return "path must not contain '..': the test stays inside the project"
	if not path.ends_with(".gd") or path.get_file().get_basename().is_empty():
		return "path must name a .gd file (e.g. res://tests/beckett/walk_test.gd)"
	return ""


## Where a suite's test goes when no path is given: <test root>/beckett/<suite>_test.gd.
static func default_path(suite: String, test_root: String = "res://tests") -> String:
	return "%s/beckett/%s_test.gd" % [test_root.trim_suffix("/"), suite]


## "" when a suite's scene is one this project could hold (res:// or user://, no '..', a sane length).
static func scene_error(scene: String) -> String:
	if not (scene.begins_with("res://") or scene.begins_with("user://")) or scene.contains("..") or scene.length() > SCENE_MAX:
		return "the suite's scene '%s' is not a scene of this project: a standalone test loads a res:// or user:// scene without '..'" % comment_text(scene, 80)
	return ""


# ---------------------------------------------------------------- building

## The step kind of a suite step: click | type | wait | assert | input | inject | state, "" for anything else.
static func step_kind(step: Variant) -> String:
	if not (step is Dictionary):
		return ""
	var d: Dictionary = step
	for k in ["click", "type", "wait", "assert", "input"]:
		if d.has(k):
			return k
	if d.has("inject") or str(d.get("kind", "")) == "inject":
		return "inject"
	if d.has("state") or str(d.get("kind", "")) == "state":
		return "state"
	return ""


## Splice the header and the data into the template: the header replaces the first line (the header marker),
## the data replaces the block between the data markers, markers included. {source} or {error}.
static func splice(tpl: String, header: String, data: String) -> Dictionary:
	var text := tpl.replace("\r\n", "\n").replace("\r", "\n")
	var lines := text.split("\n")
	var begin := -1
	var end := -1
	var damaged := ""
	if lines.is_empty() or lines[0].strip_edges() != HEADER_MARK:
		damaged = "its first line is not %s" % HEADER_MARK
	for i in lines.size():
		var l := lines[i].strip_edges()
		if i > 0 and l == HEADER_MARK:
			damaged = "%s appears twice" % HEADER_MARK
		elif l == DATA_BEGIN:
			if begin >= 0:
				damaged = "%s appears twice" % DATA_BEGIN
			begin = i
		elif l == DATA_END:
			if end >= 0:
				damaged = "%s appears twice" % DATA_END
			end = i
	if damaged.is_empty() and (begin < 0 or end < 0):
		damaged = "it has no %s ... %s block" % [DATA_BEGIN, DATA_END]
	if damaged.is_empty() and end < begin:
		damaged = "%s comes before %s" % [DATA_END, DATA_BEGIN]
	if not damaged.is_empty():
		return {"error": "the standalone test template (%s) is damaged: %s. Reinstall the addon." % [TEMPLATE_PATH, damaged]}
	var out := PackedStringArray([header.replace("\r", "")])
	out.append_array(lines.slice(1, begin))
	out.append(data.replace("\r", ""))
	out.append_array(lines.slice(end + 1))
	return {"source": "\n".join(out)}


## "" when the engine loads `source` as a script, else a sentence that says so (the caller writes nothing).
static func parse_error(source: String) -> String:
	var gd := GDScript.new()
	gd.source_code = source
	if gd.reload() == OK:
		return ""
	return "the generated test does not compile on this Godot (%s): a string in the suite holds something its literals cannot, or the template is damaged, so nothing was written. Re-save the suite with plainer text, or reinstall the addon" % Engine.get_version_info().get("string", "?")


## build_from() with the addon's own template.
static func build(doc: Dictionary, opts: Dictionary = {}) -> Dictionary:
	if not FileAccess.file_exists(TEMPLATE_PATH):
		return {"error": "the standalone test template %s is missing: reinstall the addon" % TEMPLATE_PATH}
	return build_from(FileAccess.get_file_as_string(TEMPLATE_PATH), doc, opts)


## The standalone test of a suite document: {source, mode, counts, not_run, notes} or {error}.
## opts: path (where it will be written, for the header), source (the suite file), beckett (the version),
## settle_frames (frames the replay runs on after the last event; default 4, as op=run).
static func build_from(tpl: String, doc: Dictionary, opts: Dictionary = {}) -> Dictionary:
	var suite := str(doc.get("name", ""))
	var events: Array = doc.get("events", []) if doc.get("events", []) is Array else []
	var steps: Array = doc.get("steps", []) if doc.get("steps", []) is Array else []
	var asserts: Array = doc.get("asserts", []) if doc.get("asserts", []) is Array else []
	var invariants: Array = doc.get("invariants", []) if doc.get("invariants", []) is Array else []
	if events.is_empty() and steps.is_empty():
		return {"error": "the suite has no events and no steps: there is nothing for a test to replay (re-save it with op=save)"}
	var scene_raw: Variant = doc.get("scene", "")
	var scene := str(scene_raw) if scene_raw != null else ""
	if scene.strip_edges().is_empty():
		return {"error": "the suite names no scene, and a standalone test has to load one itself: re-save it with scene=res://<the scene it plays> (playtest op=save)"}
	var bad_scene := scene_error(scene)
	if not bad_scene.is_empty():
		return {"error": bad_scene}
	var mode := "steps" if not steps.is_empty() else "events"
	var not_run: Array = []
	var notes: Array = []
	if mode == "events":
		var unstamped := false
		for i in events.size():
			var e: Variant = events[i]
			if not (e is Dictionary):
				not_run.append({"where": "events[%d]" % i, "kind": "event", "why": "not an object: the test skips it"})
				continue
			var t := str((e as Dictionary).get("type", ""))
			if not EVENT_TYPES.has(t):
				not_run.append({"where": "events[%d]" % i, "kind": t.left(KIND_CAP), "why": "unknown event type: the test cannot build it and skips it"})
			if not (e as Dictionary).has("f"):
				unstamped = true
		if unstamped:
			notes.append("some events have no frame stamps (f, written by record_input): the test puts them in on the first frame, so a timed sequence is lost; record the suite again to keep its timing")
	else:
		var clicks := false
		for i in steps.size():
			var s: Variant = steps[i]
			if not (s is Dictionary):
				not_run.append({"where": "steps[%d]" % i, "kind": "step", "why": "not an object: the flow fails there, as the editor's run does"})
				continue
			var k := step_kind(s)
			if k.is_empty():
				not_run.append({"where": "steps[%d]" % i, "kind": "step", "why": "unknown step (use one of click/type/wait/assert/input/inject/state): the flow fails there, as the editor's run does"})
			elif k == "click" or k == "type":
				clicks = true
		if clicks:
			notes.append("click and type steps push their input straight to the control: unlike the game-side click_control the test does not check what covers it (occlusion)")
	for i in asserts.size():
		var a: Variant = asserts[i]
		if not (a is Dictionary):
			not_run.append({"where": "asserts[%d]" % i, "kind": "assert", "why": "not an object {type, ...}: the test skips it"})
			continue
		var at := str((a as Dictionary).get("type", "")).strip_edges().to_lower()
		match at:
			"screenshot":
				not_run.append({"where": "asserts[%d]" % i, "kind": "screenshot", "why": WHY_SCREENSHOT})
			"perf":
				not_run.append({"where": "asserts[%d]" % i, "kind": "perf", "why": WHY_PERF})
			"no_overlap":
				not_run.append({"where": "asserts[%d]" % i, "kind": "no_overlap", "why": WHY_OVERLAP})
			_:
				if not ASSERT_KNOWN.has(at):
					not_run.append({"where": "asserts[%d]" % i, "kind": at.left(KIND_CAP), "why": "unknown assert type: the test skips it, as the editor's run does"})
	var settle := SETTLE_DEFAULT
	var settle_raw: Variant = opts.get("settle_frames", doc.get("settle_frames", null))
	if settle_raw is int or settle_raw is float:
		settle = int(settle_raw)
	elif settle_raw is String and (settle_raw as String).strip_edges().is_valid_float():
		settle = int((settle_raw as String).strip_edges().to_float())
	settle = clampi(settle, 0, 600)
	var sto := STEP_TIMEOUT_DEFAULT
	var sto_raw: Variant = doc.get("step_timeout_ms", null)
	if sto_raw is int or sto_raw is float:
		sto = maxi(100, int(sto_raw))
	var path := str(opts.get("path", default_path(suite)))
	var header := PackedStringArray([GENERATED_MARK,
		"# Suite: %s (%s, scene %s)" % [comment_text(suite, 80), mode, comment_text(scene, 120)],
		"# From: %s, Beckett %s" % [comment_text(str(opts.get("source", "")), 120), comment_text(str(opts.get("beckett", "?")), 40)],
		"# It needs no addon. Run it headless (CI):",
		"#   godot --headless --path <project> --script %s" % comment_text(path, 160)])
	if mode == "events":
		header.append("#   add --fixed-fps <the project's physics rate> to run the replay as fast as the machine allows: it counts physics frames, so the verdict is the same")
	else:
		header.append("# A steps flow runs in real time (its waits and timeouts are wall-clock), so run it at normal speed.")
	header.append("# It exits 0 on pass, 1 on fail and 2 on blocked; its last line is BECKETT_RESULT {json}.")
	header.append("# Export the suite again rather than editing this file: op=export_gd overwrites a file that starts with the line above.")
	if not not_run.is_empty():
		header.append("# NOT RUN here (printed as skipped):")
		for r in not_run:
			header.append("#   %s %s: %s" % [str(r["where"]), comment_text(str(r["kind"]), KIND_CAP), comment_text(str(r["why"]))])
	for n in notes:
		header.append("# Note: %s" % comment_text(str(n), 240))
	var data := PackedStringArray([
		"const SUITE := %s" % quote(suite),
		"const SCENE := %s" % quote(scene),
		"const MODE := %s" % quote(mode),
		"const SETTLE_FRAMES := %d" % settle,
		"const STEP_TIMEOUT_MS := %d" % sto,
		"const EVENTS := %s" % lit(events),
		"const STEPS := %s" % lit(steps),
		"const ASSERTS := %s" % lit(asserts),
		"const INVARIANTS := %s" % lit(invariants)])
	var sp := splice(tpl, "\n".join(header), "\n".join(data))
	if sp.has("error"):
		return sp
	var source := str(sp["source"])
	var perr := parse_error(source)
	if not perr.is_empty():
		return {"error": perr}
	return {"source": source, "mode": mode, "counts": {"events": events.size(), "steps": steps.size(), "asserts": asserts.size(), "invariants": invariants.size()},
		"not_run": not_run, "notes": notes}
